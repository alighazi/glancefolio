# Copy this file to deploy.conf and edit these values before deploying.
# This is sourced as Bash; use simple KEY="value" assignments only.

# Public virtual host served by Nginx.
DOMAIN=""
NGINX_PORT="80"

# On port 80, the deploy script obtains a Let's Encrypt certificate and adds
# HTTPS/redirects automatically. DNS must point DOMAIN to this server, with
# inbound ports 80 and 443 open.
ENABLE_TLS="true"
CERTBOT_EMAIL=""

# Private Kestrel upstream. Keep different from NGINX_PORT.
PORT="5000"

# Optional install locations and service account.
APP_USER="glancefolio"
APP_GROUP="glancefolio"
INSTALL_ROOT="/opt/glancefolio"
DATA_DIR="/var/lib/glancefolio"
SERVICE_NAME="glancefolio"
